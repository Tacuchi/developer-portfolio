---
import ThemeToggle from './ThemeToggle.tsx';
import { site } from '../data/site';

const currentYear = new Date().getFullYear();
---

<footer class="page">
  <div class="foot">
    <p>© {currentYear} {site.name}. Hecho con Astro + Preact.</p>

    <ul class="foot-links">
      {site.profiles.map((profile) => (
        <li><a href={profile.href} target="_blank" rel="noopener noreferrer me">{profile.label}</a></li>
      ))}
      <li><a href={site.cv}>CV</a></li>
      <li><a href={`mailto:${site.email}`}>Correo</a></li>
    </ul>

    <ThemeToggle client:visible />
  </div>
</footer>
