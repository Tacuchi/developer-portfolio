---
const currentYear = new Date().getFullYear();

const socialLinks = [
  { href: 'https://github.com/Tacuchi', label: 'GitHub', icon: 'github' },
  { href: 'https://linkedin.com/in/jloayzaloayza', label: 'LinkedIn', icon: 'linkedin' },
  { href: 'mailto:jloayza.dev@gmail.com', label: 'Email', icon: 'email' },
];
---

<footer class="border-t border-[var(--border)] bg-[var(--bg-secondary)]">
  <div class="container mx-auto px-4 py-8 max-w-5xl">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-[var(--text-secondary)] text-sm">
        © {currentYear} Tacuchi. Hecho con Astro + Preact.
      </p>

      <div class="flex items-center gap-4">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--text-secondary)] hover:text-[var(--color-primary)] transition-colors"
            aria-label={link.label}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
