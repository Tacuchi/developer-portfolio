---
import ThemeToggle from './ThemeToggle.tsx';

const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/about', label: 'Sobre mí' },
  { href: '/projects', label: 'Proyectos' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[var(--bg)]/80 border-b border-[var(--border)]">
  <nav class="container mx-auto px-4 py-4 max-w-5xl flex items-center justify-between">
    <a href="/" class="text-xl font-bold text-[var(--color-primary)] hover:text-[var(--color-primary-dark)] transition-colors">
      &lt;tacuchi /&gt;
    </a>

    <div class="flex items-center gap-6">
      <ul class="hidden sm:flex items-center gap-4">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'px-3 py-2 rounded-lg transition-colors',
                currentPath === item.href
                  ? 'bg-[var(--color-primary)] text-white'
                  : 'text-[var(--text-secondary)] hover:text-[var(--text)] hover:bg-[var(--bg-secondary)]',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <ThemeToggle client:load />
    </div>
  </nav>
</header>
