---
import { site } from '../data/site';

const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/projects', label: 'Proyectos' },
  { href: '/about', label: 'Sobre mí' },
];

// En el build las rutas llegan con barra final (/about/); en dev, sin ella.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isHome = path === '/';
const isCurrent = (href: string) =>
  href === '/' ? isHome : path === href || path.startsWith(`${href}/`);

const Name = isHome ? 'h1' : 'p';
---

<header class="site-header" data-header>
  <div class="page strip">
    <Name class="strip-name"><a href="/">{site.name}</a></Name>
    <p class="strip-headline" data-home={String(isHome)}>{site.headline}</p>
    <nav class="strip-nav" aria-label="Principal">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  // En móvil la franja fija se recoge hasta dejar solo el menú.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const nav = header?.querySelector<HTMLElement>('nav');
  if (header && nav) {
    const tuck = () => header.style.setProperty('--tuck', `${Math.max(0, nav.offsetTop - 10)}px`);
    tuck();
    addEventListener('resize', tuck);
    document.fonts?.ready.then(tuck);
  }
</script>
