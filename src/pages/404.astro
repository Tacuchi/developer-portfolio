---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout back={{ href: '/', label: 'Volver al inicio' }} title="Página no encontrada" description="Esta dirección no existe en tacuchi.dev." noindex>
  <section class="plate">
    <h1 class="page-title">Página no encontrada</h1>

    <p class="lead mt-6">
      Esta página no existe. Puede que el proyecto ya no esté publicado o que la dirección
      tenga un error.
    </p>

    <p class="act-row">
      <a class="act" href="/projects">Ver proyectos</a>
    </p>
  </section>
</BaseLayout>
