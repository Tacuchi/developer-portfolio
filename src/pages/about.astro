---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { experience } from '../data/experience';

const areas = [
  {
    title: 'Apps móviles',
    text: 'Flutter y Android nativo. Es lo que más años llevo haciendo y lo que sigo construyendo.',
  },
  {
    title: 'Plataformas web',
    text: 'Angular en el frente y Spring Boot en el backend, con PostgreSQL. Es mi trabajo diario desde 2024.',
  },
  {
    title: 'Herramientas para agentes de IA',
    text: 'agent-workflow, agent-memory y agent-skills, publicadas en GitHub y npm. Las uso todos los días en mi propio trabajo.',
  },
];
---

<BaseLayout title="Sobre mí" description="Trayectoria de Jesús Loayza Tacuchi: ingeniero de software senior en apps móviles, plataformas web y herramientas para agentes de IA.">
  <section class="plate">
    <h1 class="page-title">Sobre mí</h1>

    <p class="lead mt-6" style="max-width: 46rem">
      Soy <strong>{site.name}</strong> ({site.alias}), ingeniero de software senior.
      Programo desde 2014 y lo sigo haciendo por lo mismo que empecé: <mark>curiosidad</mark>.
      Me gusta entender cómo y por qué funciona algo antes de usarlo.
    </p>

    <p class="lead mt-4" style="max-width: 46rem">
      Construyo <mark>herramientas para que los agentes de IA trabajen con orden</mark>: un flujo de specs
      y planes, una memoria local y un catálogo de skills. Vengo de hacer apps móviles y
      plataformas web, y eso sigo haciendo en mi trabajo. Si algo de aquí te sirve, el código
      y los paquetes están enlazados en cada proyecto.
    </p>

    <div class="box-list mt-10 md:grid-cols-3">
      {areas.map((area) => (
        <div class="box">
          <h3 class="text-xl font-bold tracking-[-0.015em] mb-2">{area.title}</h3>
          <p class="max-w-[38ch]">{area.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="pb-4">
    <h2 class="section-title">Experiencia</h2>

    <div class="box-list">
      {experience.map((exp) => (
        <div data-experience class="job">
          <h3>{exp.role}</h3>
          <span class="job-period" data-current={exp.period.endsWith('actualidad') ? '' : undefined}>
            {exp.period}
          </span>
          <p class="job-company">
            {exp.employer}
            {exp.client && <span class="job-client"> · Cliente: {exp.client}</span>}
          </p>
          <p class="job-desc">{exp.description}</p>
          <p class="job-tech">{exp.tech.join(', ')}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Contacto</h2>

    <p class="lead">¿Quieres escribirme sobre alguna de estas herramientas o proyectos? Este es mi correo.</p>

    <p class="act-row">
      <a class="act" href={`mailto:${site.email}`}>{site.email}</a>
      <a class="act" href={site.cv}>Descargar CV</a>
      {site.profiles.map((profile) => (
        <a class="act" href={profile.href} target="_blank" rel="noopener noreferrer me">
          {profile.label}
        </a>
      ))}
    </p>
  </section>
</BaseLayout>
