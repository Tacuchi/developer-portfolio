---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TechBadge from '../components/TechBadge.astro';
import { site } from '../data/site';
import { featuredProjects } from '../data/projects';

const skills = {
  mobile: ['Flutter', 'Dart', 'Kotlin', 'Android', 'Jetpack Compose'],
  frontend: ['Angular', 'TypeScript', 'Astro', 'Tailwind CSS'],
  backend: ['Spring Boot', 'Java', 'PostgreSQL', 'Firebase'],
  tools: ['Git', 'Docker', 'Coolify', 'Cloudflare'],
};
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="py-16 text-center">
    <h1 class="text-4xl sm:text-5xl font-bold mb-4">
      Hola, soy <span class="text-[var(--color-primary)]">{site.name}</span>
    </h1>
    <p class="text-xl text-[var(--text-secondary)] mb-8 max-w-2xl mx-auto">
      {site.headline}
    </p>
    <div class="flex justify-center gap-4">
      <a
        href="/projects"
        class="px-6 py-3 bg-[var(--color-primary)] text-white rounded-lg hover:bg-[var(--color-primary-dark)] transition-colors"
      >
        Ver proyectos
      </a>
      <a
        href="/about"
        class="px-6 py-3 border border-[var(--border)] rounded-lg hover:bg-[var(--bg-secondary)] transition-colors"
      >
        Sobre mí
      </a>
    </div>
  </section>

  <!-- Skills Section -->
  <section class="py-12">
    <h2 class="text-2xl font-bold mb-6">Tecnologías</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="p-4 rounded-lg bg-[var(--bg-secondary)] border border-[var(--border)]">
        <h3 class="font-semibold mb-3 text-[var(--color-primary)]">📱 Mobile</h3>
        <div class="flex flex-wrap gap-2">
          {skills.mobile.map((skill) => <TechBadge name={skill} color="purple" />)}
        </div>
      </div>

      <div class="p-4 rounded-lg bg-[var(--bg-secondary)] border border-[var(--border)]">
        <h3 class="font-semibold mb-3 text-[var(--color-primary)]">🌐 Frontend</h3>
        <div class="flex flex-wrap gap-2">
          {skills.frontend.map((skill) => <TechBadge name={skill} color="cyan" />)}
        </div>
      </div>

      <div class="p-4 rounded-lg bg-[var(--bg-secondary)] border border-[var(--border)]">
        <h3 class="font-semibold mb-3 text-[var(--color-primary)]">⚙️ Backend</h3>
        <div class="flex flex-wrap gap-2">
          {skills.backend.map((skill) => <TechBadge name={skill} color="green" />)}
        </div>
      </div>

      <div class="p-4 rounded-lg bg-[var(--bg-secondary)] border border-[var(--border)]">
        <h3 class="font-semibold mb-3 text-[var(--color-primary)]">🛠️ Tools</h3>
        <div class="flex flex-wrap gap-2">
          {skills.tools.map((skill) => <TechBadge name={skill} color="orange" />)}
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="py-12">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold">Proyectos destacados</h2>
      <a href="/projects" class="text-[var(--color-primary)] hover:underline">
        Ver todos →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featuredProjects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>
  </section>
</BaseLayout>
