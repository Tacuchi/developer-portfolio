---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import Ficha from '../components/Ficha.astro';
import Figure from '../components/Figure.astro';
import { featuredProjects } from '../data/projects';

const skills = {
  Móvil: ['Flutter', 'Dart', 'Kotlin', 'Android', 'Jetpack Compose'],
  Frontend: ['Angular', 'TypeScript', 'Astro', 'Tailwind CSS'],
  Backend: ['Spring Boot', 'Java', 'PostgreSQL', 'Firebase'],
  'Agentes de IA': ['TypeScript', 'Node.js', 'Python', 'MCP', 'SQLite'],
  Herramientas: ['Git', 'Docker', 'Kubernetes', 'Coolify', 'Cloudflare'],
};

const plateNumber = (index: number) => String(index + 1).padStart(2, '0');
const longestWord = (title: string) => Math.max(...title.split(/\s+/).map((word) => word.length));
---

<BaseLayout>
  <div>
    {featuredProjects.map((project, index) => (
      <section class="plate" id={project.slug} data-plate data-hue style={`--i:${index}`}>
        <div class="plate-head">
          <h2
            class="model"
            style={`--chars:${project.title.length};--word:${longestWord(project.title)}`}
          >
            <a href={`/projects/${project.slug}`}>{project.title}</a>
          </h2>
        </div>

        <div class="plate-body">
          <div class="plate-main">
            <p class="lead">{project.description}</p>
            <Figure slug={project.slug} label={project.title} />
          </div>
          <Ficha project={project} title="Ficha" number={plateNumber(index)} />
        </div>
      </section>
    ))}

    <nav class="plate-index" aria-label="Proyectos destacados">
      <ol>
        {featuredProjects.map((project, index) => (
          <li data-hue style={`--i:${index}`}>
            <a href={`#${project.slug}`} data-plate-link={project.slug}>
              <span>{plateNumber(index)}</span>
              <strong class="max-md:sr-only">{project.title}</strong>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>

  <section class="section">
    <h2 class="section-title">Tecnologías</h2>
    <dl class="spec">
      {Object.entries(skills).map(([group, items]) => (
        <div>
          <dt>{group}</dt>
          <dd>{items.join(', ')}</dd>
        </div>
      ))}
    </dl>

    <p class="act-row">
      <a class="act" href="/projects">Ver todos los proyectos <Arrow /></a>
    </p>
  </section>
</BaseLayout>

<script>
  // Marca en el índice la lámina que se está leyendo.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-plate-link]')].map((link) => [
      link.dataset.plateLink,
      link,
    ]),
  );

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((link) => link.removeAttribute('aria-current'));
        links.get(entry.target.id)?.setAttribute('aria-current', 'true');
      }
    },
    { rootMargin: '-35% 0px -60% 0px' },
  );

  // La figura de cada lámina entra una sola vez, cuando la lámina aparece.
  const reveal = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-in');
        reveal.unobserve(entry.target);
      }
    },
    { threshold: 0.2 },
  );

  document.querySelectorAll('[data-plate]').forEach((plate) => {
    observer.observe(plate);
    reveal.observe(plate);
  });
</script>
