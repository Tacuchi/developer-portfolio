---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Ficha from '../../components/Ficha.astro';
import Figure from '../../components/Figure.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const paragraphs = project.longDescription
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.replace(/\s+/g, ' ').trim())
  .filter(Boolean);
const longestWord = Math.max(...project.title.split(/\s+/).map((word) => word.length));
---

<BaseLayout back={{ href: '/projects', label: 'Volver a proyectos' }} title={project.title} description={project.description}>
  <article class="plate" data-plate>
    <div class="plate-head">
      <h1 class="model" style={`--chars:${project.title.length};--word:${longestWord}`}>
        {project.title}
      </h1>
    </div>

    <div class="plate-body">
      <div class="plate-main">
        {project.plain ? (
          <>
            <p class="lead" data-plain>{project.plain}</p>
            <p class="plate-tech">{project.description}</p>
          </>
        ) : (
          <p class="lead">{project.description}</p>
        )}
        <Figure slug={project.slug} label={project.title} />

        <section class="mt-12">
          <h2 class="section-title">Descripción</h2>
          <div class="prose-block">
            {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>
      </div>

      <Ficha project={project} title="Características" heading="h2" />
    </div>
  </article>
</BaseLayout>

<script>
  // La figura entra una sola vez, cuando aparece. Sin JavaScript se ve igual, quieta.
  const reveal = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-in');
        reveal.unobserve(entry.target);
      }
    },
    { threshold: 0.2 },
  );
  document.querySelectorAll('[data-plate]').forEach((plate) => reveal.observe(plate));
</script>
