---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Arrow from '../../components/Arrow.astro';
import Ficha from '../../components/Ficha.astro';
import Figure from '../../components/Figure.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const paragraphs = project.longDescription
  .split(/\n\s*\n/)
  .map((paragraph) => paragraph.replace(/\s+/g, ' ').trim())
  .filter(Boolean);
const longestWord = Math.max(...project.title.split(/\s+/).map((word) => word.length));
---

<BaseLayout title={project.title} description={project.description}>
  <article class="plate">
    <a href="/projects" class="inline-flex items-center gap-2 mb-8 text-[0.9375rem]">
      <Arrow dir="left" /> Volver a proyectos
    </a>

    <div class="plate-head">
      <h1 class="model" style={`--chars:${project.title.length};--word:${longestWord}`}>
        {project.title}
      </h1>
    </div>

    <div class="plate-body">
      <div class="plate-main">
        <p class="lead">{project.description}</p>
        <Figure slug={project.slug} label={project.title} />

        <section class="mt-12">
          <h2 class="section-title">Descripción</h2>
          <div class="prose-block">
            {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>
      </div>

      <Ficha project={project} title="Características" heading="h2" />
    </div>
  </article>
</BaseLayout>
