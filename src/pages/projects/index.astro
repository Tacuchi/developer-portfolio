---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import { featuredProjects, otherProjects } from '../../data/projects';
---

<BaseLayout title="Proyectos" description="Herramientas para agentes de IA, apps móviles y otros proyectos de Jesús Loayza Tacuchi.">
  <section class="plate">
    <h1 class="page-title">Proyectos</h1>
    <p class="lead mt-6">
      Herramientas para agentes de IA, apps móviles y otros proyectos en los que he trabajado.
    </p>
  </section>

  <section class="pb-4">
    <h2 class="section-title">Destacados</h2>
    <ol class="index">
      {featuredProjects.map((project, index) => (
        <ProjectRow project={project} number={index + 1} />
      ))}
    </ol>
  </section>

  <section class="section">
    <h2 class="section-title">Más proyectos</h2>
    <ol class="index">
      {otherProjects.map((project, index) => (
        <ProjectRow project={project} number={featuredProjects.length + index + 1} />
      ))}
    </ol>
  </section>
</BaseLayout>
