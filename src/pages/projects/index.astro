---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { featuredProjects, otherProjects } from '../../data/projects';
---

<BaseLayout title="Proyectos" description="Herramientas para agentes de IA, apps móviles y otros proyectos de Jesús Loayza Tacuchi.">
  <section class="py-8">
    <h1 class="text-4xl font-bold mb-4">Proyectos</h1>
    <p class="text-xl text-[var(--text-secondary)] mb-8">
      Herramientas para agentes de IA, apps móviles y otros proyectos en los que he trabajado.
    </p>

    <h2 class="text-2xl font-bold mb-6">Destacados</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      {featuredProjects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>

    <h2 class="text-2xl font-bold mb-6">Más proyectos</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {otherProjects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>
  </section>
</BaseLayout>
